{
  "schema": "excel-workflow/1",
  "name": "示例：两表比对",
  "description": "按“订单号+商品编码”比对本期与上期，标出金额、状态不一致的单元格，并生成比对报告。",
  "files": [
    {"id": "main", "role": "main", "label": "本期订单", "match": "*本期*.xlsx"},
    {"id": "ref", "role": "ref", "label": "上期订单", "match": "*上期*.xlsx"}
  ],
  "output": {"file_name": "{main}_比对结果_{time}.xlsx"},
  "options": {"recalc": "auto"},
  "steps": [
    {"op": "match", "title": "按订单号+商品编码匹配上期", "id": "上期", "ref": "ref", "main_keys": ["订单号", "商品编码"]},
    {"op": "compare", "title": "比对金额和状态", "match": "上期",
     "compare_columns": ["金额", "状态"], "tolerance": 0.01, "highlight": "FFEB9C", "report_sheet": "比对报告", "export_csv": true},
    {"op": "format", "title": "仅本期有的订单标绿", "columns": "A:B",
     "where": {"col": "比对结果", "op": "=", "value": "仅主表有"}, "fill": "C6EFCE"}
  ]
}
